#include <winver.h>
1 ICON "../astroforge.ico"
1 VERSIONINFO
FILEVERSION     VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION  VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName",      "Contributeurs AstroForge"
      VALUE "FileDescription",  "AstroForge - traitement d'images astronomiques"
      VALUE "FileVersion",      VER_STRING
      VALUE "ProductName",      "AstroForge"
      VALUE "ProductVersion",   VER_STRING
      VALUE "LegalCopyright",   "Licence MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END

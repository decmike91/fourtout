<?xml version='1.0' encoding='utf-8'?>
<ui version="4.0">
 <class>PageSky</class>
 <widget class="QWidget" name="PageSky">
  <layout class="QHBoxLayout" name="mainH" stretch="0,1,0">
   <item>
    <widget class="QScrollArea" name="scrollParams">
     <property name="minimumWidth"><number>380</number></property>
     <property name="widgetResizable"><bool>true</bool></property>
     <widget class="QWidget" name="scrollContent">
      <property name="geometry"><rect><x>0</x><y>0</y><width>380</width><height>760</height></rect></property>
      <layout class="QVBoxLayout" name="paramsLayout">
       <property name="sizeConstraint"><enum>QLayout::SetMinAndMaxSize</enum></property>
       <item>
        <widget class="QGroupBox" name="grpImages">
         <property name="title"><string>1. Images brutes (FITS/TIFF/PNG/RAW)</string></property>
         <layout class="QVBoxLayout" name="layImages">
           <item><layout class="QHBoxLayout" name="commandsImages"><item><widget class="QPushButton" name="btnLaunch_grpImages"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpImages"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item><widget class="QListWidget" name="listLight"><property name="minimumHeight"><number>90</number></property><property name="selectionMode"><enum>QAbstractItemView::ExtendedSelection</enum></property></widget></item>
          <item>
           <layout class="QHBoxLayout" name="layImgBtns">
            <item><widget class="QPushButton" name="btnAddLight"><property name="text"><string>Ajouter…</string></property></widget></item>
            <item><widget class="QPushButton" name="btnClearLight"><property name="text"><string>Vider</string></property></widget></item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="layBayer">
            <item><widget class="QLabel" name="lblBayer"><property name="text"><string>Matrice de Bayer :</string></property></widget></item>
            <item><widget class="QComboBox" name="cmbBayer"><item><property name="text"><string>Aucune (mono)</string></property></item><item><property name="text"><string>RGGB</string></property></item><item><property name="text"><string>BGGR</string></property></item><item><property name="text"><string>GRBG</string></property></item><item><property name="text"><string>GBRG</string></property></item></widget></item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpCalib">
         <property name="title"><string>2. Calibration — création des Masters</string></property>
         <layout class="QGridLayout" name="gridCalib">
           <item row="5" column="0" colspan="3"><layout class="QHBoxLayout" name="commandsCalib"><item><widget class="QPushButton" name="btnLaunch_grpCalib"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpCalib"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item row="0" column="0"><widget class="QLabel" name="lblBias"><property name="text"><string>Bias :</string></property></widget></item>
          <item row="0" column="1"><widget class="QLineEdit" name="txtBias" /></item>
          <item row="0" column="2"><widget class="QPushButton" name="btnBias"><property name="text"><string>…</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lblDark"><property name="text"><string>Dark :</string></property></widget></item>
          <item row="1" column="1"><widget class="QLineEdit" name="txtDark" /></item>
          <item row="1" column="2"><widget class="QPushButton" name="btnDark"><property name="text"><string>…</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lblFlat"><property name="text"><string>Flat :</string></property></widget></item>
          <item row="2" column="1"><widget class="QLineEdit" name="txtFlat" /></item>
          <item row="2" column="2"><widget class="QPushButton" name="btnFlat"><property name="text"><string>…</string></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="lblDarkFlat"><property name="text"><string>Dark-flat :</string></property></widget></item>
          <item row="3" column="1"><widget class="QLineEdit" name="txtDarkFlat" /></item>
          <item row="3" column="2"><widget class="QPushButton" name="btnDarkFlat"><property name="text"><string>…</string></property></widget></item>
          <item row="4" column="1"><layout class="QVBoxLayout" name="profCalib" /></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpAlign">
         <property name="title"><string>3. Alignement &amp; Drizzle</string></property>
         <layout class="QGridLayout" name="gridAlign">
           <item row="5" column="0" colspan="2"><layout class="QHBoxLayout" name="commandsAlign"><item><widget class="QPushButton" name="btnLaunch_grpAlign"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpAlign"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item row="0" column="0" colspan="2"><widget class="QCheckBox" name="chkRotation"><property name="text"><string>Tenir compte de la rotation du champ</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lblDrizzle"><property name="text"><string>Drizzle :</string></property></widget></item>
          <item row="1" column="1"><widget class="QComboBox" name="cmbDrizzle"><item><property name="text"><string>Sans</string></property></item><item><property name="text"><string>×2</string></property></item><item><property name="text"><string>×3</string></property></item></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lblPixfrac"><property name="text"><string>Pixfrac :</string></property></widget></item>
          <item row="2" column="1"><widget class="QDoubleSpinBox" name="spnPixfrac"><property name="minimum"><double>0.100000000000000</double></property><property name="maximum"><double>1.000000000000000</double></property><property name="singleStep"><double>0.050000000000000</double></property><property name="value"><double>0.700000000000000</double></property></widget></item>
          <item row="3" column="0" colspan="2"><layout class="QVBoxLayout" name="profAlign" /></item><item row="4" column="0"><widget class="QLabel" name="lblRegMethod"><property name="text"><string>Méthode :</string></property></widget></item><item row="4" column="1"><widget class="QComboBox" name="cmbRegMethod"><item><property name="text"><string>Phase (translation+rotation)</string></property></item><item><property name="text"><string>Étoiles (similarity)</string></property></item><item><property name="text"><string>Plate solving + distorsions (poly)</string></property></item></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpStack">
         <property name="title"><string>4. Empilement</string></property>
         <layout class="QGridLayout" name="gridStack">
           <item row="3" column="0" colspan="2"><layout class="QHBoxLayout" name="commandsStack"><item><widget class="QPushButton" name="btnLaunch_grpStack"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpStack"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item row="0" column="0"><widget class="QLabel" name="lblStackM"><property name="text"><string>Algorithme :</string></property></widget></item>
          <item row="0" column="1"><widget class="QComboBox" name="cmbStackMethod"><item><property name="text"><string>Sigma-clipping</string></property></item><item><property name="text"><string>Moyenne</string></property></item><item><property name="text"><string>Médiane</string></property></item><item><property name="text"><string>Winsorisé</string></property></item><item><property name="text"><string>Rejet min/max</string></property></item><item><property name="text"><string>Linear fit</string></property></item><item><property name="text"><string>MAD clipping</string></property></item></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lblSigma"><property name="text"><string>Sigma :</string></property></widget></item>
          <item row="1" column="1"><widget class="QDoubleSpinBox" name="spnSigma"><property name="minimum"><double>1.000000000000000</double></property><property name="maximum"><double>10.000000000000000</double></property><property name="value"><double>3.000000000000000</double></property></widget></item>
          <item row="2" column="0" colspan="2"><layout class="QVBoxLayout" name="profStack" /></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpTrait">
         <property name="title"><string>5. Traitement (fond, denoise, déconvolution)</string></property>
         <layout class="QGridLayout" name="gridTrait">
           <item row="6" column="0" colspan="3"><layout class="QHBoxLayout" name="commandsTrait"><item><widget class="QPushButton" name="btnLaunch_grpTrait"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpTrait"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item row="0" column="0"><widget class="QLabel" name="lblGradM"><property name="text"><string>Gradient :</string></property></widget></item>
          <item row="0" column="1"><widget class="QComboBox" name="cmbGradMethod"><item><property name="text"><string>Polynôme 2D</string></property></item><item><property name="text"><string>RBF (thin plate)</string></property></item></widget></item>
          <item row="0" column="2"><widget class="QComboBox" name="cmbGradCorr"><item><property name="text"><string>Soustraction</string></property></item><item><property name="text"><string>Division</string></property></item></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lblGradDeg"><property name="text"><string>Degré :</string></property></widget></item>
          <item row="1" column="1"><widget class="QSpinBox" name="spnGradDeg"><property name="minimum"><number>1</number></property><property name="maximum"><number>5</number></property><property name="value"><number>3</number></property></widget></item>
          <item row="1" column="2"><widget class="QSpinBox" name="spnGradGrid"><property name="minimum"><number>4</number></property><property name="maximum"><number>40</number></property><property name="value"><number>12</number></property><property name="suffix"><string> cases</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lblDenoiseM"><property name="text"><string>Denoise :</string></property></widget></item>
          <item row="2" column="1" colspan="2"><widget class="QComboBox" name="cmbDenoiseMethod"><item><property name="text"><string>Non-local means</string></property></item><item><property name="text"><string>Bilatéral</string></property></item><item><property name="text"><string>Médiane</string></property></item><item><property name="text"><string>Ondelettes</string></property></item></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="lblDenoiseS"><property name="text"><string>Force :</string></property></widget></item>
          <item row="3" column="1" colspan="2"><widget class="QSlider" name="sldDenoiseStrength"><property name="maximum"><number>100</number></property><property name="value"><number>50</number></property><property name="orientation"><enum>Qt::Horizontal</enum></property></widget></item>
          <item row="4" column="0"><widget class="QLabel" name="lblDeconv"><property name="text"><string>Déconv. itérations :</string></property></widget></item>
          <item row="4" column="1"><widget class="QSpinBox" name="spnDeconvIters"><property name="maximum"><number>200</number></property><property name="value"><number>20</number></property></widget></item>
          <item row="4" column="2"><widget class="QDoubleSpinBox" name="spnDeconvSigma"><property name="maximum"><double>6.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property><property name="value"><double>1.500000000000000</double></property><property name="prefix"><string>σ=</string></property></widget></item>
          <item row="5" column="0" colspan="3"><layout class="QVBoxLayout" name="profTrait" /></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpIA">
         <property name="title"><string>6. IA locale (denoise, fond, netteté, super-résolution, satellites)</string></property>
         <layout class="QGridLayout" name="gridIA">
           <item row="5" column="0" colspan="3"><layout class="QHBoxLayout" name="commandsIA"><item><widget class="QPushButton" name="btnLaunch_grpIA"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpIA"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item row="0" column="0"><widget class="QLabel" name="lblAITask"><property name="text"><string>Tâche :</string></property></widget></item>
          <item row="0" column="1" colspan="2"><widget class="QComboBox" name="cmbAITask"><item><property name="text"><string>denoise</string></property></item><item><property name="text"><string>background</string></property></item><item><property name="text"><string>sharpen</string></property></item><item><property name="text"><string>superres</string></property></item><item><property name="text"><string>satellite</string></property></item></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lblAIProv"><property name="text"><string>Fournisseur :</string></property></widget></item>
          <item row="1" column="1" colspan="2"><widget class="QComboBox" name="cmbAIProvider" /></item>
          <item row="2" column="0"><widget class="QLabel" name="lblAIStrength"><property name="text"><string>Force :</string></property></widget></item>
          <item row="2" column="1" colspan="2"><widget class="QSlider" name="sldAIStrength"><property name="maximum"><number>100</number></property><property name="value"><number>50</number></property><property name="orientation"><enum>Qt::Horizontal</enum></property></widget></item>
          <item row="3" column="0" colspan="3"><widget class="QPushButton" name="btnAIConfig"><property name="text"><string>Configurer les outils IA (chemins)…</string></property></widget></item>
          <item row="4" column="0" colspan="3"><layout class="QVBoxLayout" name="profIA" /></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpHDR">
         <property name="title"><string>7. Composition HDR (plusieurs empilements)</string></property>
         <layout class="QVBoxLayout" name="layHDR">
           <item><layout class="QHBoxLayout" name="commandsHDR"><item><widget class="QPushButton" name="btnLaunch_grpHDR"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpHDR"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item><widget class="QListWidget" name="listHDR"><property name="minimumHeight"><number>60</number></property></widget></item>
          <item>
           <layout class="QHBoxLayout" name="layHDRBtns">
            <item><widget class="QPushButton" name="btnAddHDR"><property name="text"><string>Ajouter exposition…</string></property></widget></item>
            <item><widget class="QPushButton" name="btnDoHDR"><property name="text"><string>Fusionner HDR</string></property></widget></item>
           </layout>
          </item>
          <item><layout class="QVBoxLayout" name="profHDR" /></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpPipe">
         <property name="title"><string>8. Processus de traitement automatique</string></property>
         <layout class="QVBoxLayout" name="layPipe">
           <item><layout class="QHBoxLayout" name="commandsPipe"><item><widget class="QPushButton" name="btnLaunch_grpPipe"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpPipe"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item><widget class="QListWidget" name="lstSteps"><property name="minimumHeight"><number>110</number></property></widget></item>
          <item>
           <layout class="QHBoxLayout" name="layPipeBtns1">
            <item><widget class="QPushButton" name="btnStepUp"><property name="text"><string>↑</string></property></widget></item>
            <item><widget class="QPushButton" name="btnStepDown"><property name="text"><string>↓</string></property></widget></item>
            <item><widget class="QPushButton" name="btnStepToggle"><property name="text"><string>Activer/désactiver</string></property></widget></item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="layPipeBtns2">
            <item><widget class="QPushButton" name="btnPipeSave"><property name="text"><string>Enregistrer processus…</string></property></widget></item>
            <item><widget class="QPushButton" name="btnPipeLoad"><property name="text"><string>Charger…</string></property></widget></item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
              <item>
        <widget class="QGroupBox" name="grpColor">
         <property name="title"><string>8. Calibration couleur &amp; neutralisation</string></property>
         <layout class="QGridLayout" name="gridColor">
           <item row="4" column="0" colspan="3"><layout class="QHBoxLayout" name="commandsColor"><item><widget class="QPushButton" name="btnLaunch_grpColor"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpColor"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item row="0" column="0"><widget class="QPushButton" name="btnColorCal"><property name="text"><string>Calibration couleur (fond ciel)</string></property></widget></item>
          <item row="0" column="1"><widget class="QPushButton" name="btnBgNeutral"><property name="text"><string>Neutraliser le fond</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lblBgPct"><property name="text"><string>Percentile fond :</string></property></widget></item>
          <item row="1" column="1"><widget class="QSpinBox" name="spnBgPct"><property name="minimum"><number>5</number></property><property name="maximum"><number>60</number></property><property name="value"><number>25</number></property></widget></item>
          <item row="2" column="0" colspan="2"><widget class="QPushButton" name="btnSCNR"><property name="text"><string>SCNR vert (OSC)</string></property></widget></item>
          <item row="3" column="0" colspan="3"><widget class="QPushButton" name="btnPCC"><property name="text"><string>Calibration photométrique des couleurs (étoiles Gaia)</string></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpAstro">
         <property name="title"><string>9. Astrométrie locale (plate solving &amp; photométrie)</string></property>
         <layout class="QGridLayout" name="gridAstro">
           <item row="6" column="0" colspan="3"><layout class="QHBoxLayout" name="commandsAstro"><item><widget class="QPushButton" name="btnLaunch_grpAstro"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpAstro"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item row="0" column="0"><widget class="QLabel" name="lblCat"><property name="text"><string>Catalogue CSV :</string></property></widget></item>
          <item row="0" column="1"><widget class="QLineEdit" name="txtCatalog" /></item>
          <item row="0" column="2"><widget class="QPushButton" name="btnCatalogBrowse"><property name="text"><string>…</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lblRA"><property name="text"><string>RA centre :</string></property></widget></item>
          <item row="1" column="1" colspan="2"><widget class="QLineEdit" name="txtRA"><property name="placeholderText"><string>10:25:03 ou 156.26</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lblDec"><property name="text"><string>Dec centre :</string></property></widget></item>
          <item row="2" column="1" colspan="2"><widget class="QLineEdit" name="txtDec"><property name="placeholderText"><string>+19:48 ou 19.8</string></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="lblRadius"><property name="text"><string>Rayon (deg) :</string></property></widget></item>
          <item row="3" column="1"><widget class="QDoubleSpinBox" name="spnRadius"><property name="value"><double>1.000000000000000</double></property><property name="maximum"><double>30.000000000000000</double></property></widget></item>
          <item row="3" column="2"><widget class="QPushButton" name="btnSolve"><property name="text"><string>Plate solving</string></property></widget></item>
          <item row="4" column="0"><widget class="QPushButton" name="btnPhotometry"><property name="text"><string>Photométrie → CSV</string></property></widget></item>
          <item row="4" column="1"><widget class="QPushButton" name="btnDPH"><property name="text"><string>Photom. différentielle → CSV</string></property></widget></item>
          <item row="5" column="0" colspan="3"><widget class="QLabel" name="lblAstroResult"><property name="text"><string>—</string></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpDefects">
         <property name="title"><string>10. Pixels défectueux — carte &amp; colonnes/lignes mortes</string></property>
         <layout class="QGridLayout" name="gridDefects">
           <item row="4" column="0" colspan="3"><layout class="QHBoxLayout" name="commandsDefects"><item><widget class="QPushButton" name="btnLaunch_grpDefects"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpDefects"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
          <item row="0" column="0" colspan="3"><widget class="QCheckBox" name="chkDefects"><property name="text"><string>Corriger (après calibration)</string></property></widget></item>
          <item row="1" column="0" colspan="2"><widget class="QCheckBox" name="chkDefectsAuto"><property name="text"><string>Détection auto (master dark/flat)</string></property></widget></item>
          <item row="1" column="2"><widget class="QCheckBox" name="chkDefectsCols"><property name="text"><string>Colonnes/lignes</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lblBPM"><property name="text"><string>Carte (FITS/PNG/TXT) :</string></property></widget></item>
          <item row="2" column="1"><widget class="QLineEdit" name="txtBPM" /></item>
          <item row="2" column="2"><widget class="QPushButton" name="btnBPM"><property name="text"><string>…</string></property></widget></item>
          <item row="3" column="0" colspan="3"><layout class="QVBoxLayout" name="profDefects" /></item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="vSpaceSky"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <layout class="QVBoxLayout" name="previewContainer" />
   </item>
   <item>
    <layout class="QVBoxLayout" name="rightCol">
     <item>
      <widget class="QGroupBox" name="grpRun">
       <property name="title"><string>Exécution</string></property>
       <layout class="QVBoxLayout" name="layRun">
         <item><layout class="QHBoxLayout" name="commandsRun"><item><widget class="QPushButton" name="btnLaunch_grpRun"><property name="text"><string>Lancer</string></property></widget></item><item><widget class="QPushButton" name="btnCancel_grpRun"><property name="text"><string>Annuler</string></property></widget></item></layout></item>
        <item><widget class="QPushButton" name="btnProcess"><property name="text"><string>▶ Traiter (pleine résolution) et exporter…</string></property></widget></item>
        <item><widget class="QPushButton" name="btnExport"><property name="text"><string>Exporter l'image…</string></property></widget></item>
        <item><widget class="QProgressBar" name="progress"><property name="value"><number>0</number></property></widget></item>
        <item><widget class="QPlainTextEdit" name="log"><property name="minimumSize"><size><width>260</width><height>300</height></size></property><property name="readOnly"><bool>true</bool></property></widget></item>
       </layout>
      </widget>
     </item>
     <item><spacer name="vSpaceRight"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
